PORT=5000

DATABASE_URL=postgresql://username:password@host/database?sslmode=require

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your_google_client_id

# Comma-separated list of allowed frontend origins (CORS).
# Required for browsers; leave empty to allow any origin (default).
# Production example:
#   CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=

NODE_ENV=development

# NOTE: Run `npm run db:init` then `npm run db:seed` to create the initial
# admin/customer/store-owner test accounts used for local and production login.
