PORT=5000

DATABASE_URL=postgresql://username:password@host/database?sslmode=require

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your_google_client_id

NODE_ENV=development

# NOTE: When NODE_ENV is not "production", a hardcoded admin login is available:
#   Email: admin
#   Password: admin
# This is for local testing only and will NOT work in production.
